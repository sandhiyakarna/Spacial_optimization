# Database Configuration
# Use SQLite locally if PostgreSQL is not running: sqlite:///./flowspace.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowspace

# Security & Authentication (JWT)
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=supersecretjwtkeyplaceholderchangeinproduction
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Application Configuration
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Ollama & AI Provider Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
AI_PROVIDER=ollama
